; Stellar Legacy - novo cliente Godot, independente do projeto web
; Engine: Godot 4.x - renderer Compatibility (Android primeiro)
config_version=5

[application]

config/name="Stellar Legacy | Godot G0.17"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.015, 0.024, 0.055, 1)
