static func get_ship(name: String) -> Dictionary:
    return SHIPS.get(name.to_upper(), {})

static func max_slots(ship_name: String, kind: String) -> int:
    var ship: Dictionary = get_ship(ship_name)
    match kind:
        "ARMAS": return int(ship.get("lasers", 1))
        "ESCUDOS", "MOTORES": return int(ship.get("generators", 1))
        "EXTRAS": return int(ship.get("extras", 1))
    return 0
